// Football Board Game — rules configuration (spec v1.1 + v1.3 decisions).
// Any key you delete falls back to the built-in default. Unknown keys and
// out-of-range values are rejected when the file is loaded.
// Coordinates: column 0 is Red's goal line; Red attacks toward higher columns.
{
  "schemaVersion": 1,

  "board": {
    "rows": 13,                  // odd, >= 13 (bigger fields: 15, 17, ...)
    "columns": 26,               // even, >= 26 (bigger fields: 28, 30, ...)
    "goalWidth": 5,              // odd, centred on each short edge
    "penaltyBoxWidth": 5,        // odd, >= goalWidth
    "penaltyBoxDepth": 4,        // columns in front of the goal line, including it
    "maxPlayersPerSquare": 2
  },

  "teams": {
    "playersPerTeam": 5,         // including the goalkeeper; 2..11
    // Optional fixed kick-off layouts per player count, written for Red
    // (column = distance from own goal line, rowOffset = rows from the centre row).
    // The first spot is the goalkeeper. Counts not listed get an automatic layout.
    "formations": {
      "5": [
        { "column": 0, "rowOffset": 0 },
        { "column": 5, "rowOffset": -2 },
        { "column": 5, "rowOffset": 2 },
        { "column": 10, "rowOffset": -2 },
        { "column": 10, "rowOffset": 2 }
      ]
    }
  },

  "goalkeeper": {
    "maxMoveCells": 2,           // the player picks 1 or 2 cells each turn; always inside the own penalty box
    "maxMoveCellsWhenBallNear": 1, // ...but only 1 while the ball is near the keeper's box
    "nearBallRings": 1,          // "near" = inside the box or this many rings around it (-1 = no limit)
    // Goal chance for an on-target shot by distance from target cell to keeper
    // (index 0 = same cell, 1 = one cell away, last value = that distance or more).
    "goalChanceByDistance": [0.05, 0.3, 0.6, 0.8],
    "diveReachCells": 2          // a shot aimed further than this from the keeper is always a goal (-1 = no limit)
  },

  "passing": {
    "laneTolerance": 0.05,                    // fraction of a cell width around each cell centre
    "revalidateLaneAfterMovement": false,     // v1.3: lane checked only at declaration
    "longPassSuccessChance": 0.1111111111,    // 1/9; on failure the ball lands on 1 of the 8 cells around the receiver
    "contestedDestinationSuccessChance": 0.5, // opponent on the receiver's square
    "allowForwardPassFromSharedSquare": false,
    "maxStraightPassFieldFraction": 0.5       // a pass may cover at most half the pitch length (13 squares); longer = long pass
  },

  "shooting": {
    "accuracyInsideBox": 1.0,          // chance the shot is on target from inside the opponent's penalty box
    "accuracyDropPerRing": 0.05,          // first ring around the box: -5%
    "accuracyDropIncreasePerRing": 0.01,  // each further ring drops 1% more: -6%, -7%, ... (95%, 89%, 82%, 74%, ...)
    "minimumAccuracy": 0.2,               // never below 20%
    "contestedShooterWinChance": 0.5   // opponent on the shooter's square
  },

  "carrier": {
    "canMoveOnOpponentTurn": true   // the ball carrier may also move one cell on the other team's turn (never pass/shoot then)
  },

  "tackle": {
    "enabled": true,
    "successChance": 0.5
  },

  "clock": {
    "secondsPerStep": 30,              // a team turn = arrangement step + action step
    "defaultMinutes": 10,
    "presetMinutes": [10, 20, 30, 40, 50, 60, 70, 90]
  },

  "turns": {
    "possessionTeamPlaysFirst": true,  // the team with the ball takes every turn until it loses it (false = strict alternation)
    "actionBeforeMovement": true       // the pass/shot resolves first, then all players move (false = move first, then act)
  },

  "ties": {
    "offerGoldenGoal": true,
    "goldenGoalRequiresBothTeams": true
  }
}
